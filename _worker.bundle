      productId: `template:${tpl.id}`,
      productType: PRODUCT_TYPES.TEMPLATE,
      productName: tpl.name || "Premium Celebration Blueprint",
      description: tpl.description || `Single template access for ${tpl.name || tpl.id}`,
      templateId: tpl.id,
