      score += 15;
      tokenMatches++;
    } else if (features.includes(t)) {
      score += 15;
      tokenMatches++;
    } else if (tags.some((tag) => tag.includes(t))) {
      score += 10;
      tokenMatches++;
    } else if (desc.includes(t)) {
      score += 8;
      tokenMatches++;
    } else if (vector.includes(t)) {
      score += 5;
