    id: jobId,
    job_type: dryRun ? "dry_run" : "orphan_cleanup",
    status: "completed",
    target_provider: targetProvider,
    dry_run: dryRun ? 1 : 0,
    items_scanned: itemsScanned,
    items_quarantined: dryRun ? 0 : cleanedItems.length,
