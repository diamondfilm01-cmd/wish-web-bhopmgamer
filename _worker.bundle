      versionId: tv.id,
      templateId: templateFamilyId,
      versionLabel,
      isPublished,
      status: finalStatus,
      filesChecked: fileResults.length,
      files: fileResults,
      integrityFailed: finalStatus === STORAGE_HEALTH_STATUS.INTEGRITY_FAILED
