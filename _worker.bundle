async function auditMusicAssetsIntegrity({
  musicList = [],
  wishes = [],
  b2Provider = null
}) {
  const results = [];
  let healthyMusic = 0;
  let missingMusic = 0;
  for (const track of musicList) {
    const isB2 = track.storageProvider === "b2" || track.playbackUrl && track.playbackUrl.includes("backblazeb2");
