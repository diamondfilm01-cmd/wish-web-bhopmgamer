    if (finalStatus === STORAGE_HEALTH_STATUS.HEALTHY) {
      healthyMusic++;
    } else {
      missingMusic++;
    }
    results.push({
      id: track.id,
      title: track.title,
      artist: track.artist,
      category: track.category,
      storageKey,
      playbackUrl: track.playbackUrl,
      status: finalStatus,
      isProtected: protection.isProtected,
      protectionReasons: protection.reasons,
      error: check.error || null
    });
  }
