  return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>${escapeHtml2(title)} | WishMagic</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: radial-gradient(circle at center, #19062e 0%, #0d0217 60%, #05000a 100%);
      color: #f3e8ff;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      box-sizing: border-box;
      padding: 24px;
    }
    .card {
      max-width: 480px;
      width: 100%;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(236, 72, 153, 0.25);
      border-radius: 24px;
      padding: 40px 28px;
      backdrop-filter: blur(20px);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    }
    .icon {
      font-size: 48px;
      margin-bottom: 16px;
    }
    h1 {
      font-size: 24px;
      font-weight: 800;
      margin: 0 0 12px 0;
      background: linear-gradient(135deg, #f472b6, #c084fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    p {
      font-size: 14px;
      line-height: 1.6;
      color: rgba(243, 232, 255, 0.75);
      margin: 0 0 24px 0;
    }
    .btn {
      display: inline-block;
      padding: 12px 28px;
      background: linear-gradient(135deg, #ec4899, #a855f7);
      color: #ffffff;
      font-weight: 700;
      font-size: 13px;
      text-decoration: none;
      border-radius: 9999px;
      box-shadow: 0 4px 15px rgba(236, 72, 153, 0.4);
      transition: transform 0.2s, opacity 0.2s;
    }
    .btn:hover {
      opacity: 0.95;
      transform: scale(1.02);
    }
    .brand {
      margin-top: 24px;
      font-size: 11px;
      color: rgba(243, 232, 255, 0.35);
      letter-spacing: 0.05em;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="icon">\u2728</div>
    <h1>${escapeHtml2(heading)}</h1>
    <p>${escapeHtml2(message)}</p>
    <a href="${escapeHtml2(buttonHref)}" class="btn">${escapeHtml2(buttonText)}</a>
    <div class="brand">WishMagic \u2022 Interactive Keepsake Platform</div>
  </div>
</body>
</html>`;
}
