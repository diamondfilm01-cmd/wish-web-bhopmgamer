      if (l.status === LEDGER_STATUS.PENDING) pendingCount++;
      return {
        id: l.id,
        role: l.role,
        rewardType: l.reward_type,
        rewardAmount: l.reward_amount,
        status: l.status,
        grantedAt: l.granted_at,
        claimedAt: l.claimed_at,
        createdAt: l.created_at
      };
