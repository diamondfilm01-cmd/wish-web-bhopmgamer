{
  "protocol": "1.0",
  "type": "wish-template",
  "template": {
    "id": "tpl_parents_tribute",
    "title": "Dearest Parents Tribute",
    "category": "family",
    "description": "Gentle botanical heartfelt tribute card for parents with family photo keepsake and blessing letter."
  },
  "capabilities": {
    "photos": true,
    "video": false,
    "music": false,
    "voice": false,
    "countdown": true,
    "themes": false,
    "animations": false,
    "particles": false
  },
  "fields": [
    {
      "id": "recipient_name",
      "key": "recipient_name",
      "label": "Parents / Recipient Name",
      "type": "text",
      "required": true,
      "placeholder": "e.g. Maa & Papa"
    },
    {
      "id": "event_date",
      "key": "event_date",
      "label": "Special Date",
      "type": "date",
      "required": true
    },
    {
      "id": "sender_name",
      "key": "sender_name",
      "label": "From (Your Name)",
      "type": "text",
      "required": false,
      "placeholder": "e.g. Your Loving Child"
    },
    {
      "id": "custom_message",
      "key": "custom_message",
      "label": "Letter of Gratitude",
      "type": "textarea",
      "required": false,
      "defaultValue": "Thank you for being our guiding light, our biggest strength, and our forever home."
    },
    {
      "id": "photo_1",
      "key": "photo_1",
      "label": "Treasured Family Portrait",
      "type": "image",
      "required": false,
      "defaultValue": "https://images.unsplash.com/photo-1511895426328-dc8714191300?w=600&auto=format&fit=crop&q=80"
    }
  ],
  "sections": []
}