{
  "protocol": "1.0",
  "type": "wish-template",
  "template": {
    "id": "tpl_golden_anniversary",
    "title": "Golden Memories Keepsake",
    "category": "anniversary",
    "description": "Luxurious golden jubilee tribute card with memory photo frame and heartfelt gratitude letter."
  },
  "capabilities": {
    "photos": true,
    "video": false,
    "music": false,
    "voice": false,
    "countdown": true,
    "themes": false,
    "animations": false,
    "particles": false
  },
  "fields": [
    {
      "id": "recipient_name",
      "key": "recipient_name",
      "label": "Couple / Recipient Name",
      "type": "text",
      "required": true,
      "placeholder": "e.g. Mom & Dad"
    },
    {
      "id": "event_date",
      "key": "event_date",
      "label": "Anniversary Date",
      "type": "date",
      "required": true
    },
    {
      "id": "sender_name",
      "key": "sender_name",
      "label": "From (Your Name)",
      "type": "text",
      "required": false,
      "placeholder": "e.g. With Love, Family"
    },
    {
      "id": "custom_message",
      "key": "custom_message",
      "label": "Anniversary Tribute Message",
      "type": "textarea",
      "required": false,
      "defaultValue": "Celebrating years of unwavering love, laughter, and timeless memories together."
    },
    {
      "id": "photo_1",
      "key": "photo_1",
      "label": "Milestone Memory Photo",
      "type": "image",
      "required": false,
      "defaultValue": "https://images.unsplash.com/photo-1511285560929-80b456fea0bc?w=600&auto=format&fit=crop&q=80"
    }
  ],
  "sections": []
}