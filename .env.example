# WishMagic Production Environment Configuration (Example)
PORT=3000
NODE_ENV=production
APP_NAME=WishMagic
PUBLIC_APP_URL=https://wishmagic.pages.dev

# Cloudflare D1 & R2 Bindings (configured in wrangler.toml)
# D1: DB
# R2: BUCKET

# Security & Sessions
JWT_SECRET=your_jwt_secret_key_here
COOKIE_SECRET=your_cookie_signing_secret_here

# Payment Provider Integration (Optional - Part 20 Cloud Ready)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# Notification Delivery Providers (Optional - Part 20 Cloud Ready)
RESEND_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Firebase Client Configuration (wish-magic-47944)
FIREBASE_API_KEY=AIzaSyCiZmxmfgyj555EI4af_rt5X_id31F4Vq0
FIREBASE_AUTH_DOMAIN=wish-magic-47944.firebaseapp.com
FIREBASE_PROJECT_ID=wish-magic-47944
FIREBASE_STORAGE_BUCKET=wish-magic-47944.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=281035115213
FIREBASE_APP_ID=1:281035115213:web:2af5b3a6f0ceb6c64eb784

# ImgBB Image Cloud Hosting
IMGBB_API_KEY=your_imgbb_api_key_here
IMGBB_API_URL=https://api.imgbb.com/1/upload

# Backblaze B2 Cloud Storage (Music, Audio & Video Vault)
# In Cloudflare Pages/Workers: set via `wrangler secret put <KEY>` or Cloudflare dashboard
# In Node.js / Local dev: set in environment or .env file
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=wishmagic-assets
B2_BUCKET_ID=
B2_ENDPOINT=https://api.backblazeb2.com
B2_DOWNLOAD_URL=


# Content Moderation & Media Quarantine Providers (Part 47)
# Configure at least one external provider for production image/video/audio AI & OCR scanning:
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
GOOGLE_VISION_API_KEY=
OPENAI_API_KEY=
MODERATION_API_URL=
MODERATION_API_KEY=
MODERATION_TIMEOUT_MS=8000
MODERATION_REQUIRE_EXTERNAL_AV_SCAN=false
