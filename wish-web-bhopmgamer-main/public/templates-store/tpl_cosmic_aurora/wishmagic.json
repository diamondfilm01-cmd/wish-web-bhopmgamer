{
  "protocol": "wishmagic-template",
  "schemaVersion": "1.0.0",
  "template": {
    "id": "tpl_cosmic_aurora",
    "name": "Cosmic Birthday Aurora",
    "version": "1.0.0",
    "category": "birthday",
    "description": "A magical celestial experience with shimmering aurora effects and starlight animations.",
    "author": "WishMagic Studio",
    "tier": "vip",
    "price": 49
  },
  "compatibility": {
    "runtimeApi": "1.0",
    "minimumRuntimeApi": "1.0"
  },
  "capabilities": [
    "photos",
    "music",
    "countdown",
    "animations",
    "particles",
    "themes",
    "sections"
  ],
  "sections": [
    {
      "id": "sec_hero",
      "title": "Cosmic Greeting",
      "required": true
    },
    {
      "id": "sec_countdown",
      "title": "Midnight Countdown",
      "required": false,
      "toggleable": true
    },
    {
      "id": "sec_letter",
      "title": "Starlit Message",
      "required": true
    },
    {
      "id": "sec_gallery",
      "title": "Celestial Memories",
      "required": true
    },
    {
      "id": "sec_finale",
      "title": "Grand Finale",
      "required": true
    }
  ],
  "fields": [
    {
      "id": "recipient_name",
      "label": "Recipient Name",
      "type": "text",
      "required": true,
      "defaultValue": "Star Traveler",
      "section": "sec_hero"
    },
    {
      "id": "event_date",
      "label": "Birthday Date",
      "type": "date",
      "required": true,
      "section": "sec_countdown"
    },
    {
      "id": "custom_message",
      "label": "Personal Message",
      "type": "textarea",
      "required": true,
      "defaultValue": "May your orbit around the sun be filled with infinite magic!",
      "section": "sec_letter"
    },
    {
      "id": "hero_photo",
      "label": "Cover Photo",
      "type": "image",
      "required": true,
      "section": "sec_hero"
    },
    {
      "id": "aurora_color",
      "label": "Aurora Hue",
      "type": "color",
      "required": false,
      "defaultValue": "#00FFCC",
      "section": "sec_hero"
    }
  ],
  "relationships": [
    "friend",
    "best_friend",
    "girlfriend",
    "boyfriend",
    "general"
  ],
  "assets": [
    {
      "file": "index.html",
      "role": "entry_html"
    },
    {
      "file": "style.css",
      "role": "stylesheet"
    },
    {
      "file": "script.js",
      "role": "script"
    }
  ]
}
