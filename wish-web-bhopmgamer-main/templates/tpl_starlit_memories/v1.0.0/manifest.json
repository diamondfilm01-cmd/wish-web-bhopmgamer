{
  "protocol": "wishmagic-template",
  "schemaVersion": "1.0.0",
  "template": {
    "id": "tpl_starlit_memories",
    "name": "Starlit Memories",
    "description": "A cinematic journey through a starlit night sky, perfect for magical birthdays and romantic anniversaries.",
    "templateVersion": "1.0.0",
    "category": "Birthday",
    "tier": "vip",
    "price": 49,
    "entry": "index.html",
    "author": "WishMagic Studio"
  },
  "compatibility": {
    "runtimeApi": "1.0",
    "minimumRuntimeApi": "1.0"
  },
  "capabilities": [
    "photos",
    "multiplePhotos",
    "music",
    "countdown",
    "animations",
    "particles",
    "sections",
    "themes"
  ],
  "fields": [
    {
      "id": "recipient_name",
      "label": "Recipient Name",
      "type": "text",
      "required": true,
      "defaultValue": "Someone Special",
      "placeholder": "Enter their name",
      "binding": { "target": "text", "selector": "#recipient-name" }
    },
    {
      "id": "sender_name",
      "label": "From",
      "type": "text",
      "required": true,
      "defaultValue": "Your Friend",
      "binding": { "target": "text", "selector": "#sender-name" }
    },
    {
      "id": "event_date",
      "label": "Celebration Date",
      "type": "date",
      "required": true,
      "binding": { "target": "value", "selector": "#celebration-countdown" }
    },
    {
      "id": "main_message",
      "label": "The Starry Message",
      "type": "textarea",
      "required": true,
      "defaultValue": "Wishing you a day as bright and beautiful as the stars in the night sky. May your year ahead be filled with cosmic joy and infinite happiness.",
      "binding": { "target": "text", "selector": "#main-message" }
    },
    {
      "id": "cover_photo",
      "label": "Cover Photo",
      "type": "image",
      "role": "cover",
      "required": true,
      "binding": { "target": "background-image", "selector": "#hero-backdrop" }
    },
    {
      "id": "memories",
      "label": "Starlit Memories",
      "type": "image-multiple",
      "role": "gallery",
      "constraints": { "minItems": 1, "maxItems": 6 },
      "binding": { "target": "collection", "selector": "#memory-grid" }
    },
    {
      "id": "star_color",
      "label": "Star Glow Color",
      "type": "color",
      "defaultValue": "#FCD34D",
      "binding": { "target": "css-variable", "variable": "--star-glow" }
    }
  ],
  "sections": [
    {
      "id": "hero",
      "title": "Starlit Greeting",
      "required": true,
      "order": 1
    },
    {
      "id": "letter",
      "title": "The Cosmic Scroll",
      "required": true,
      "order": 2
    },
    {
      "id": "gallery",
      "title": "Memory Constellations",
      "toggleable": true,
      "order": 3
    },
    {
      "id": "countdown",
      "title": "Celebration Countdown",
      "toggleable": true,
      "order": 4
    }
  ],
  "relationships": [
    {
      "id": "girlfriend",
      "overrides": {
        "main_message": "To my shining star, you make my universe complete. Happy Birthday to the most beautiful girl in the cosmos."
      }
    },
    {
      "id": "best_friend",
      "overrides": {
        "main_message": "To my partner in cosmic crime! Let's party until the sun rises. Have a stellar birthday, buddy!"
      }
    }
  ],
  "assets": [
    { "path": "style.css", "role": "stylesheet" },
    { "path": "script.js", "role": "script" },
    { "path": "assets/star-bg.jpg", "role": "background" }
  ]
}
